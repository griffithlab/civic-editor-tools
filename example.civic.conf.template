# Template for a CIViC connection config file, used by --civic-config.
#
# Copy this file to something matching '*.civic.conf' (e.g. username.prod.civic.conf) - that naming
# convention is required, and is what keeps it out of git via .gitignore. Never rename it to
# something that doesn't end in '.civic.conf', and never commit the copy.
#
# The file must be readable by its owner only (like an AWS .pem file):
#   chmod 600 username.prod.civic.conf
#
# To obtain an API key, log in to CIViC, go to your user profile and use the Manage API Keys function
#
# api_url must be exactly one of:
#   https://civicdb.org          (production - requires typed confirmation to use)
#   https://staging.civicdb.org

contributor_id = 15
organization_id = 1
api_key = your-civic-api-key-here
api_url = https://staging.civicdb.org

# ---------------------------------------------------------------------------------------------
# OPTIONAL: LLM provider credentials, only needed for review_evidence_items.py --llm-assist.
# You only need the set for the provider you use (chosen with --llm-profile), not both.
# Uncomment and fill in the lines for your provider; leave the rest commented out.
# ---------------------------------------------------------------------------------------------

# For --llm-profile claude (the default). If omitted, the ANTHROPIC_API_KEY environment variable
# is used instead; if both are set, this value wins.
#anthropic_api_key = your-anthropic-api-key-here

# For --llm-profile wustl (WashU AI API gateway). All three are required together. The client id
# and client secret are used to obtain a short-lived Microsoft Entra bearer token (refreshed
# automatically); the API key ties each request to your account's model access and quota. All
# three come from the gateway dashboard, where they can be regenerated (the client secret
# expires after a year).
#llm_gateway_client_id = your-gateway-client-id-here
#llm_gateway_client_secret = your-gateway-client-secret-here
#llm_gateway_api_key = your-gateway-api-key-here


